{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@kiwano/typeorm#build": {
      "dependsOn": ["^build", "@kiwano/core#build"],
      "outputs": ["dist/**"]
    },
    "kiwano#build": {
      "dependsOn": ["^build", "@kiwano/core#build"],
      "outputs": ["dist/**"]
    }
  }
}
