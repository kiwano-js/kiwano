{
  "extends": "./node_modules/@wittignl/js-config/typescript/library.tsconfig.jsonc",
  "compilerOptions": {
    "composite": true,
    /* Bundler - Input: */
    "rootDir": "./src/ts",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "@rslib/core/types",
      "./src/ts/types"
    ],
    /* Bundler - Output: */
    "outDir": "./dist",
    "declarationDir": "./dist/types",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "moduleResolution": "bundler",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "ignoreDeprecations": "6.0",
    /* Compat */
    "strict": false
  },
  "files": [],
  "include": [
    "./src/ts/**/*.ts",
    "./src/ts/**/*.tsx",
    "./src/ts/**/*.d.ts",
    "./src/ts/**/*.js",
    "./src/ts/**/*.jsx",
    "./src/ts/**/*.json"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ],
  "references": [
    { "path": "../core" }
  ]
}
